# Loaded only by `next dev`. Safe to commit: these are local-preview values, not secrets.
# Stores data as JSON files in ./.localdata and shows the sign-in link on the page instead of emailing it.
LOCAL_STORE_DIR=.localdata
SESSION_SECRET=local-dev-secret-local-dev-secret-123456
DEV_SHOW_LINK=true

# Local SQLite file standing in for Turso (create/update it with `npm run db:migrate`).
TURSO_DATABASE_URL=file:local.db
