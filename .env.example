# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Emails that are always admins (comma separated)
ADMIN_EMAILS=jill@snacksdesign.com

# Sign-in emails via Resend (resend.com). Leave blank locally: the sign-in link shows on the page instead.
RESEND_API_KEY=
FROM_EMAIL="Band Carpool <carpool@snacksdesign.com>"

# Optional: your custom domain, used in sign-in links (Vercel's production URL is used otherwise)
SITE_URL=

# Turso database (required in production). Without it, local dev saves to ./.localdata
#   turso db show <name> --url     and     turso db tokens create <name>
# A local SQLite file works too: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
