# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# First admins (comma separated), used only while no one in the database is an admin.
# After that, manage admins in Admin → Admin emails.
ADMIN_EMAILS=jill@snacksdesign.com

# Sign-in emails via Resend (resend.com). Leave blank locally: the sign-in link shows on the page instead.
RESEND_API_KEY=
FROM_EMAIL="Band Carpool <carpool@snacksdesign.com>"

# Optional: your custom domain, used in sign-in links (Vercel's production URL is used otherwise)
SITE_URL=

# Turso database (required in production). Without it, local dev saves to ./.localdata/carpool.db
#   turso db show <name> --url     and     turso db tokens create <name>
# A local SQLite file works too: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Maintenance mode: set to 1 to show the "Back soon" page everywhere and close the API (503). Leave blank normally.
MAINTENANCE_MODE=
# Optional while MAINTENANCE_MODE is on: a long secret (e.g. `openssl rand -hex 16`). Visiting any page with
# ?bypass=<secret> lets that browser see the site for a week.
MAINTENANCE_BYPASS=
