# Production environment variables (set these in Vercel → Project → Settings → Environment Variables).

# 40+ random characters: openssl rand -hex 32
SESSION_SECRET=

# Magic-link email via Resend
RESEND_API_KEY=
FROM_EMAIL="Band Carpool <carpool@example.com>"

# Always-admin emails, comma separated
ADMIN_EMAILS=

# Optional: canonical URL used in sign-in links, e.g. https://carpool.example.com
SITE_URL=

# Turso database. Added automatically when you connect Turso from the Vercel Marketplace.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Upstash Redis (used until the app moves onto Turso). Added automatically when you connect Upstash from the Vercel Marketplace
# (either the KV_* or UPSTASH_* names work).
KV_REST_API_URL=
KV_REST_API_TOKEN=
